# ============================================================================
# 1. REQUIRED — MongoDB Configuration
# ============================================================================
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster-url>/?retryWrites=true&w=majority
MONGODB_DB_NAME=bazardor

# ============================================================================
# 2. REQUIRED — Better Auth Configuration
# Generate a strong secret with: openssl rand -base64 32
# ============================================================================
BETTER_AUTH_SECRET=your_generated_32_char_minimum_secret_here
BETTER_AUTH_URL=http://localhost:3000

# ============================================================================
# 3. OPTIONAL — OAuth Social Login Providers (Google & GitHub)
# Leave empty if social login is not needed locally, or provide valid
# OAuth app credentials to enable Google and GitHub sign-in buttons.
# ============================================================================
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# ============================================================================
# 4. OPTIONAL — BazarDor Public API Override
# Defaults to https://openapi.programming-hero.com/api/bazardor when omitted
# ============================================================================
BAZARDOR_API_BASE_URL=https://openapi.programming-hero.com/api/bazardor
